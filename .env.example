# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection string.
#  - Local dev: run `npm run db:local` (embedded PGlite server) and use:
#      postgresql://postgres:postgres@127.0.0.1:5433/postgres
#  - Vercel: the Neon pooled connection string (…-pooler.….neon.tech/bloom?sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres

# Auth.js v5 session secret. Generate with: openssl rand -base64 32  (or: npx auth secret)
AUTH_SECRET=
# The site URL. http://localhost:3000 locally; the production URL on Vercel.
AUTH_URL=http://localhost:3000

# Required to create a teacher account on /signup. Students never self-register.
TEACHER_INVITE_CODE=

# scripts/seed.ts — the two teacher accounts it creates (Ticket 0.9).
SEED_TEACHER_EMAIL=
SEED_TEACHER_PASSWORD=
SEED_COLLEAGUE_EMAIL=
SEED_COLLEAGUE_PASSWORD=
